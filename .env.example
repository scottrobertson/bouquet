# Directory for everything we persist: the SQLite database and backups.
# Defaults to ./data in dev.
CONFIG_PATH=./data

# Cron expression for the scheduled provider resync. Defaults to daily at 4am.
SYNC_CRON=0 4 * * *

# Cron expression for scheduled backups. Defaults to daily at 3am.
BACKUP_CRON=0 3 * * *

# How many scheduled backups to keep. Older auto-backups are pruned; manual and
# hand-added files are kept. Defaults to 14.
BACKUP_KEEP=14

# Port the server listens on.
PORT=3000
