# Password for the single login. Required in production.
APP_PASSWORD=changeme

# Secret used to sign the session cookie and authorize the internal sync call.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=changeme

# Directory for everything we persist: the SQLite database and backups.
# Defaults to ./data in dev.
CONFIG_PATH=./data

# Cron expression for the scheduled provider resync. Defaults to daily at 4am.
SYNC_CRON=0 4 * * *

# Port the server listens on.
PORT=3000
